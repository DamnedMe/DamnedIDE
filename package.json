{
  "name": "damned-ide",
  "version": "0.0.7",
  "description": "IDE leggero per backend .NET con gestione worktree Git, Azure DevOps e SQL Server",
  "main": "./out/main/index.js",
  "author": {
    "name": "Damian Tateo",
    "email": "damian.tateo@revoltech.ai"
  },
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:sql-e2e": "vite --config vite.sql-e2e.config.ts --host 127.0.0.1 --port 4173",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --config electron-builder.yml",
    "release": "electron-vite build && electron-builder --config electron-builder.yml --publish always",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:ai": "node --experimental-strip-types scripts/ai-stream-json.check.ts",
    "test:roslyn-nav": "node --experimental-strip-types scripts/roslyn-nav.check.ts",
    "test:git-discard": "node --experimental-strip-types scripts/git-discard.check.ts",
    "test:worktree-remove": "node --experimental-strip-types scripts/worktree-remove.check.ts",
    "test:fs-watch": "node --experimental-strip-types scripts/fs-watch.check.ts",
    "test:open-target": "node --experimental-strip-types scripts/open-target.check.ts",
    "test:sql-ui": "node --experimental-strip-types scripts/sql-ui-regression.mjs",
    "test:sql-guards": "node --experimental-strip-types scripts/sql-linux-guards.check.ts",
    "test:sql-playwright": "playwright test --config playwright.config.ts",
    "test:sql": "npm run test:sql-ui && npm run test:sql-playwright",
    "test:sql-playwright:report": "playwright show-report playwright-report/sql",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@azure/identity": "^4.13.1",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "@monaco-editor/react": "^4.6.0",
    "@tediousjs/connection-string": "^0.5.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.344.0",
    "mssql": "^11.0.1",
    "simple-git": "^3.25.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.35.3",
    "typescript": "^5.3.3",
    "vite": "^5.1.0"
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "esbuild@0.21.5": true
  }
}
